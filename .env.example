# PostgreSQL for local development only.
POSTGRES_DB=belcanto
POSTGRES_USER=belcanto
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://belcanto:replace-with-a-local-password@localhost:5432/belcanto?sslmode=disable
# Optional: point tests at a disposable database; each integration test uses an isolated schema.
TEST_DATABASE_URL=postgres://belcanto:replace-with-a-local-password@localhost:5432/belcanto?sslmode=disable

# Generate with: openssl rand -base64 32
TOKEN_HMAC_KEY_BASE64=replace-with-at-least-32-random-bytes-in-base64

LISTEN_ADDRESS=:8080
# Local development may use the custom scheme. Production rejects it and
# requires an HTTPS /activate URL matching the mobile verified app-link origin.
APP_ENV=development
PUBLIC_ACTIVATION_BASE_URL=belcanto://activate
AUTO_MIGRATE=false
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
